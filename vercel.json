{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "realtors-elizabethtown-ky.vercel.app"
        }
      ],
      "destination": "https://www.etownkyrealtors.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)__next(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
